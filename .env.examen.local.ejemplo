# CREDENCIALES DEL EXAMEN — plantilla.
#
# Cópiala a un fichero llamado .env.examen.local (en esta misma carpeta) y
# rellena los valores con el Bloc de notas, justo detrás del signo =, sin espacios
# y sin comillas. Ese fichero NO se sube a GitHub: git lo ignora por la regla
# .env*.local del .gitignore. Esta plantilla sí se sube, y por eso va vacía.
#
# Lo usa sólo scripts/examen.mjs con --lanzar, para iniciar sesión como tu
# usuario administrador y llamar a /api/admin/examen. Si el token caduca a mitad
# de tanda, lo renueva solo con estos mismos datos.

# La dirección de Doclity en producción, tal como la escribes en el navegador. Ej.: https://tu-app.vercel.app
EXAMEN_URL_BASE=

# La URL de Supabase. En Vercel: Settings > Environment Variables > NEXT_PUBLIC_SUPABASE_URL
EXAMEN_SUPABASE_URL=

# La clave pública de Supabase. En Vercel: NEXT_PUBLIC_SUPABASE_ANON_KEY. Es pública: va en la web del navegador.
EXAMEN_SUPABASE_ANON_KEY=

# El CORREO con el que entras en Doclity como administrador de la organización del piloto.
EXAMEN_CORREO=

# La CONTRASEÑA de ese mismo usuario, la que escribes en la pantalla de login. Sólo se envía a Supabase para iniciar sesión.
EXAMEN_CONTRASENA=
